{
  "name": "v2v-token-server",
  "version": "0.1.0",
  "private": true,
  "description": "Mints short-lived OpenAI Realtime client secrets for the V2V iOS app. Runs locally only (docs/DECISIONS.md D-019).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "supertest": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
