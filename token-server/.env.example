# Copy to .env (git-ignored) and fill in. Never commit real values.

# Your OpenAI API key. It stays on this Mac only.
OPENAI_API_KEY=

# Shared secret the iOS app sends in the x-app-secret header.
# Generate one with: openssl rand -hex 32
# Put the same value in the app's Config/Secrets.xcconfig (APP_SHARED_SECRET).
APP_SHARED_SECRET=

PORT=8787
